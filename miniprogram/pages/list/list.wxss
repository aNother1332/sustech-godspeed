/* pages/list/list.wxss */
.page {
  min-height: 100vh;
  background: #F2F2F7;
  padding: 24rpx 0 60rpx;
  box-sizing: border-box;
}

/* 顶部红色风险提示 */
.warning-banner {
  margin: 0 32rpx 24rpx;
  background: #FDECEC;
  border: 2rpx solid #F5C6C6;
  border-left: 8rpx solid #E64545;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}
.warning-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #C0392B;
  margin-bottom: 12rpx;
}
.warning-text {
  font-size: 24rpx;
  color: #A94438;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.tip {
  margin-top: 40vh;
  text-align: center;
  color: #8E8E93;
  font-size: 28rpx;
}

.list {
  background: #FFFFFF;
  margin: 0 32rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #F2F2F7;
}
.row:last-child {
  border-bottom: none;
}

.row-main {
  flex: 1;
}
.vehicle-id {
  font-size: 34rpx;
  font-weight: 600;
  color: #1C1C1E;
  letter-spacing: 2rpx;
}

/* 「去找车」入口：仿主页底部灰字 + 箭头的暗示样式 */
.find-link {
  font-size: 24rpx;
  color: #AEAEB2;
  margin-right: 20rpx;
  padding: 10rpx 0;
}
.find-link-hover {
  opacity: 0.5;
}
.find-chevron {
  color: #C7C7CC;
}

/* 状态徽标颜色与详情页三色渐变一致 */
.badge {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.badge-fast {
  background: #10B981;
}
.badge-normal {
  background: #ED8F03;
}
.badge-slow {
  background: #E64545;
}

/* ===== 找车强制阅读弹窗 ===== */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-card {
  width: 640rpx;
  height: 78vh;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx 32rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #C0392B;
  text-align: center;
  margin-bottom: 20rpx;
}
.modal-scroll {
  flex: 1;
  min-height: 0;
}
.modal-body {
  padding-bottom: 40rpx;
}
.m-sec {
  font-size: 28rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin: 20rpx 0 10rpx;
}
.m-text {
  font-size: 26rpx;
  color: #48484A;
  line-height: 1.8;
  margin-bottom: 10rpx;
}
.modal-bottom-pad {
  padding: 20rpx 0 30rpx;
}
.m-hint {
  text-align: center;
  font-size: 24rpx;
  color: #C7C7CC;
  padding: 16rpx 0;
}
.modal-go-btn {
  background: #007AFF;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-go-btn::after {
  border: none;
}
.modal-go-btn-disabled {
  background: #E9E9EB;
  color: #AEAEB2;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-cancel {
  margin-top: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8E8E93;
  padding: 12rpx 0;
}

/* 上次辅助找车时间 */
.last-find {
  text-align: center;
  font-size: 24rpx;
  color: #6B6B6D;
  background: #F2F2F7;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-bottom: 16rpx;
}

/* ===== 用车高峰期禁用提示弹窗 ===== */
.rush-card {
  height: auto;
}
.rush-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #B45309;
  text-align: center;
  margin-bottom: 24rpx;
}
.rush-text {
  font-size: 27rpx;
  color: #48484A;
  line-height: 1.8;
  margin-bottom: 20rpx;
}
.rush-ok-btn {
  background: #B45309;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}
.rush-ok-btn::after {
  border: none;
}
